// Secrets.example.xcconfig — template. Copy to Secrets.xcconfig (gitignored)
// and fill in. Base.xcconfig pulls it in with #include?, so a missing file is
// not a build error.
//
//     cp ios/Config/Secrets.example.xcconfig ios/Config/Secrets.xcconfig
//
// The same four values exist in the web app's .env as VITE_TODOIST_API_TOKEN,
// VITE_MIRAIE_AUTH_TOKEN and VITE_MIRAIE_DEVICE_ID; the studytime password is
// hardcoded in src/api/studytime.ts.
//
// On first launch the app copies each of these into the keychain and reads only
// from there afterwards, so a later build without this file keeps working on a
// device that has already run once.

TODOIST_API_TOKEN =
MIRAIE_AUTH_TOKEN =
MIRAIE_DEVICE_ID =
STUDYTIME_PASSWORD =
